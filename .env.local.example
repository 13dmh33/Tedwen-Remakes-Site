# Quincy Chat Agent — get key at https://console.anthropic.com
ANTHROPIC_API_KEY=

# Resend email notifications — get key at https://resend.com, update TED_EMAIL in lib/email.ts
RESEND_API_KEY=

# Google Sheets lead tracker
# 1. Create a Google Cloud project, enable Sheets API
# 2. Create a Service Account, download JSON credentials
# 3. Paste entire JSON as one line below
# 4. Share your Sheet (tab named "Leads") with the service account email (Editor)
# 5. Paste the Sheet ID from the URL
# Columns: A:Timestamp B:Name C:Phone D:Email E:Service F:Zip G:Notes H:Source I:Status
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_SHEET_ID=
